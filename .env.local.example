# Copy to .env.local for local use. On a host such as Vercel, set these in the project settings.

# Passcode for /admin (the list of all submissions). Required in production: without it the
# admin area stays locked. Use a long random value when the app is online.
ADMIN_KEY=change-me

# Storage. Leave these unset to store submissions in data/db.json on this computer.
# Set them (from a free Upstash Redis database) to store submissions online instead.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
